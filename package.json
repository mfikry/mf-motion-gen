{
  "name": "mf-motion-gen-v2",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "MF Motion Gen 2.0 — Isolated HTML-to-video rendering studio",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test tests/unit/preflightValidator.test.mjs tests/unit/securityProtocol.test.mjs tests/unit/frameMath.test.mjs tests/unit/archiveAndImport.test.mjs tests/unit/staticAnalyzerAndDiff.test.mjs",
    "test:e2e": "node scripts/run-electron-e2e.mjs sprint1",
    "test:e2e:sprint2": "node scripts/run-electron-e2e.mjs sprint2",
    "test:e2e:sprint3": "node scripts/run-electron-e2e.mjs sprint3",
    "test:e2e:sprint4": "node scripts/run-electron-e2e.mjs sprint4",
    "test:e2e:sprint5": "node scripts/run-electron-e2e.mjs sprint5"
  },
  "dependencies": {
    "@hyperframes/engine": "0.9.93",
    "@hyperframes/producer": "0.9.93"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.4.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
